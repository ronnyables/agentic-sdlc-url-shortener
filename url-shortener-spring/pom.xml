<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.schwab</groupId>
    <artifactId>url-shortener-spring</artifactId>
    <version>1.0.0</version>
    <name>url-shortener-spring</name>
    <description>URL shortener service (Spring Boot / Maven / JPA edition)</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <!--
      No Lombok. An earlier version of this pom used it for entity boilerplate
      (getters/setters/builder), but Lombok requires the build's annotation
      processor to actually run, which is one more thing that can silently
      fail depending on Maven/JDK/OS combination (and did, on first real-world
      build - see docs/06-spring-boot-rebuild.md). The entity classes
      (ShortUrl, ClickEvent) now have hand-written boilerplate instead, which
      trades a bit of verbosity for zero dependency on annotation-processor
      configuration being correct.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>url-shortener-spring</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!--
                  This pom targets Java 17 (see java.version above), but Surefire runs
                  tests on whatever JDK is on the developer's PATH/JAVA_HOME - which may
                  be newer. Mockito's inline mock maker (used by @MockBean in the
                  @WebMvcTest slice tests) depends on Byte Buddy, which does not
                  recognize very new JDK class-file versions until it's explicitly
                  updated for them; without this flag, mocking any class on an
                  unrecognized JDK fails with "Java N is not supported by the current
                  version of Byte Buddy". net.bytebuddy.experimental=true tells Byte
                  Buddy to proceed anyway. Harmless on older, already-supported JDKs.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
